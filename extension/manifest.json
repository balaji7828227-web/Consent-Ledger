{
  "manifest_version": 3,
  "name": "Consent Ledger",
  "version": "1.0.0",
  "description": "Privacy monitoring Chrome extension analyzing user consent decisions and website tracking activity.",
  "permissions": [
    "storage",
    "tabs",
    "activeTab",
    "webRequest"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_popup": "popup/popup.html",
    "default_title": "Consent Ledger"
  }
}
